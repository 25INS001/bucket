# Environment, Cache and temp files
venv/
__pycache__/
media/

# NOTE: migrations/ used to be ignored here. Django migrations are source, not
# build output — without them a fresh database has no storage_objectmetadata
# table and every /bucket/ request fails. They must be committed.

# Database
db.sqlite3

garage-data/
*.txt
.env
staticfiles/
.pytest_cache/

# The test suite ships a requirements file; *.txt above would hide it.
!tests/requirements.txt

# So would the C++ build files, which are source. A blanket *.txt is a sharp
# edge in a repository whose build system is driven by .txt files: without
# these the tree clones without a CMakeLists and nothing builds, with no error
# to explain why.
!CMakeLists.txt
!conanfile.txt
